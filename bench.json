{
  // The bench as data. Addresses marked "TBD" are unknown; `probe` reports them as
  // unconfigured rather than trying to open them. Fill them in here, or in a git-ignored
  // bench.local.json beside this file, which overlays this one entry-by-entry on Role.
  //
  // dutOption sets the max-leveled-power limits (manual Table 4-9):
  //   Standard = front panel out WITH attenuator
  //   Opt001   = front panel out, no attenuator
  //   Opt004   = rear panel out with attenuator
  //   Opt005   = rear panel out, no attenuator
  "dutOption": "Standard",
  "dutSerial": "TBD",

  "instruments": [
    { "role": "dut",                "model": "HP 8340B",  "address": "GPIB0::19::INSTR", "timeoutMs": 20000,
      "note": "Factory default address is 19 — CONFIRM against the instrument." },

    { "role": "spectrum-analyzer",  "model": "HP 8563E",  "address": "GPIB0::18::INSTR" },
    { "role": "counter",            "model": "HP 5351A",  "address": "GPIB0::14::INSTR",
      "note": "Fed from the Z3805A via the Symmetricom distribution amplifier, but the counter has no command to read its reference state back — confirm EXT REF at the front panel. 4-2 depends on it." },
    { "role": "function-generator", "model": "HP 3325B",  "address": "GPIB0::10::INSTR" },
    { "role": "plotter",            "model": "HP 7090A",  "address": "GPIB0::6::INSTR" },
    { "role": "oscilloscope",       "model": "Rigol DS1104Z",
      "address": "TCPIP0::192.168.1.145::inst0::INSTR",
      "note": "Confirm the LAN address has not moved." },

    // Any of the 3458A, 34401A or DM3058 can fill this role -- see "Which multimeter" in
    // docs/GEAR-MAP.md. The 432A is the accuracy limit, not the meter, at every level this
    // bench measures. Change the model here and the drivers and uncertainty budget follow.
    { "role": "dmm",                "model": "HP 3458A",  "address": "TBD",
      "note": "Pluggable: HP 3458A, HP 34401A or Rigol DM3058. A DM3058E has no GPIB." },
    { "role": "measuring-receiver", "model": "HP 8902A",  "address": "TBD", "timeoutMs": 20000,
      "note": "With the 11792A sensor module (50 MHz-18 GHz) — the primary absolute-power path." },
    { "role": "lo-source",          "model": "HP 8673B",  "address": "TBD",
      "note": "2-26 GHz, CW only here. LO for the 11793A in S6 and for phase-noise down-conversion. Unlike the 5351A it CAN prove it is on the house reference: extended status bit 3 plus bit 4 clear." },
    { "role": "switch-driver",      "model": "HP 11713A", "address": "TBD",
      "note": "Listen-only: presence cannot be confirmed over the bus." },
    { "role": "pulse-generator",    "model": "HP 8116A",  "address": "TBD" },
    { "role": "audio-analyzer",     "model": "HP 8903B",  "address": "TBD",
      "note": "Closes the 5-5 step 48 active-probe gap (M2-09)." },
    { "role": "vector-generator",   "model": "Agilent E4438C", "address": "TBD",
      "note": "Frequency option TBD (1/2/3/4/6 GHz). Clean low-band LO and phase-noise baseline source." },
    { "role": "arb-generator",      "model": "Rigol DG1032Z",  "address": "TBD" },
    { "role": "switch-matrix",      "model": "Agilent 3499A",  "address": "TBD",
      "note": "2x 33311C (26.5 GHz), several 33311B (18 GHz), 44472A dual 1:4 VHF. Slot map TBD — `probe` queries module ID per slot." },

    // Standing absolute-power path, and the one that covers the whole instrument. The 437B is on
    // HP-IB, so both sensors below are automatable. Together they span 10 MHz - 26.5 GHz, which
    // is the entire range of the 8340B: nothing needs borrowing for power.
    { "role": "power-meter",        "model": "HP 437B",  "address": "TBD", "timeoutMs": 15000,
      "note": "Reads both sensors below. Zero and calibrate against its own 50 MHz 1 mW reference." },

    // The thermistor path. The 432A has NO HP-IB at all: it is read through the 3458A, with the
    // 44472A in the 3499A selecting between its rear-panel RECORDER, V_RF and V_COMP terminals.
    // Independent of the diode sensors above -- different physics, different traceability chain --
    // and the only sensor on this bench for 10-50 MHz, which 4-5 needs.
    { "role": "thermistor-power-meter", "model": "HP 432A", "address": "n/a (read via the 3458A)",
      "probeable": false,
      "note": "No HP-IB. RANGE, CALIBRATION FACTOR and MOUNT RESISTANCE are front-panel only and must be declared. MOUNT RESISTANCE must be 200 ohms for the 478A." },

    { "role": "thermistor-mount",      "model": "HP 478A", "address": "n/a (plugs into the 432A)",
      "probeable": false,
      "note": "10 MHz - 10 GHz, 200 ohms, 10 mW maximum. Rule 5 REFUSES any DUT setting above +7 dBm into this mount. Its six calibration points are printed on the mount itself and must be entered -- see decision D-06." },

    // Sensors are not separately addressable — they plug into the 437B. Listed so the driver can
    // enforce the right frequency range and power limit for whichever is connected, and so the
    // session records which one produced a reading.
    { "role": "power-sensor-low",   "model": "HP 8481A", "address": "n/a (reads via the 437B)",
      "probeable": false,
      "note": "10 MHz - 18 GHz, -30 to +20 dBm, Type-N. The only sensor covering 10-50 MHz apart from the 478A thermistor." },
    { "role": "power-sensor-high",  "model": "HP 8485A", "address": "n/a (reads via the 437B)",
      "probeable": false,
      "note": "Cal-factor data 30 MHz - 26.5 GHz, -30 to +20 dBm, 3.5 mm (m). This is what makes band 4 Spec. Option 033 would reach 33 GHz — confirm which variant this is." },

    // Borrowed kit. present=false until it is physically on the bench; when a borrowed
    // 26.5 GHz sensor is present, band-4 power measurements upgrade from Relative to Spec.
    // No longer needed for power: the resident 8481A + 8485A on the 437B already cover
    // 10 MHz - 26.5 GHz. Kept present:false as an optional independent second opinion only.
    { "role": "usb-power-sensor",   "model": "Keysight U8485A", "address": "TBD", "present": false, "borrowed": true,
      "note": "Borrowed, and now OPTIONAL — the resident 8485A already makes band 4 Spec. Useful only as an independent cross-check." },

    // Still genuinely needed from the borrow list: a 26.5 GHz splitter for 4-6 in band 4, and
    // 3.5 mm pads rated to 26.5 GHz.
    { "role": "splitter-26g",       "model": "HP 11667B", "address": "n/a (passive)", "present": false, "borrowed": true,
      "probeable": false,
      "note": "Borrowed. DC-26.5 GHz. Needed for 4-6 external leveling in band 4; the resident 11667A stops at 18 GHz." }
  ]
}
